{
  "name": "race-jeunes",
  "version": "1.6.0",
  "private": true,
  "description": "Suivi de la Race jeunes d'un club de tennis — PWA en marque blanche, sans donnée personnelle",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "tokens": "node scripts/build-tokens.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:remote": "node scripts/migrate.mjs",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "local-db": "node scripts/local-db.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.18"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "next": "^15.5.29",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
