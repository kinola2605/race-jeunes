# Modèle de configuration. Copier en .env (local) — jamais versionné, comme tous les .env.*.
# Aucune valeur réelle ici. Production / Preview : variables saisies dans Vercel (voir docs/DEPLOIEMENT.md).

# --- Base de données ---------------------------------------------------------------------------
# Application : URL POOLÉE (Neon : hôte « -pooler »), rôle applicatif race_app (sans DDL).
DATABASE_URL="postgresql://race:race@localhost:54329/race"
# Migrations uniquement : URL DIRECTE (sans « -pooler »), rôle propriétaire.
DATABASE_URL_UNPOOLED="postgresql://race:race@localhost:54329/race"

# --- Sessions ----------------------------------------------------------------------------------
# Clé HMAC aléatoire, 32 caractères minimum, différente par environnement. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Facultative : sans elle, en production, l'application génère sa clé et la conserve en base (spec 016).
SESSION_SECRET=""

# --- Installation en un clic (spec 016) ---------------------------------------------------------
# Code demandé par l'écran de premier démarrage /installation (8 caractères minimum), tant qu'aucun admin n'existe.
INSTALL_CODE=""

# --- Marque blanche (toutes optionnelles, lues à l'exécution). Logos à déposer dans public/logo/. --
APP_NAME="Race jeunes"
CLUB_NAME=""
CLUB_SHORT_NAME=""
BRAND_LOGO=""
BRAND_LOGO_LIGHT=""

# --- Docker / développement uniquement (inutiles sur Vercel) ----------------------------------
# Mot de passe de la base utilisé par docker compose
POSTGRES_PASSWORD=""
# Bootstrap du premier admin au démarrage du conteneur (mot de passe à changer à la 1re connexion).
ADMIN_PSEUDO=""
ADMIN_PASSWORD=""
# Données de démonstration. Jamais en production (le seed refuse VERCEL_ENV=production).
SEED_DEMO="false"
# "false" pour un test local en HTTP ; par défaut Secure dès que NODE_ENV=production.
COOKIE_SECURE="false"
