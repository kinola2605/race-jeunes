# Copier en .env (jamais versionné). Aucune donnée personnelle ici.

# Connexion PostgreSQL
DATABASE_URL="postgresql://race:race@localhost:5432/race"

# Mot de passe de la base utilisé par docker compose
POSTGRES_PASSWORD="change-moi"

# Bootstrap du premier admin (au démarrage du conteneur ou via `npm run bootstrap-admin`).
# Le compte est créé s'il n'existe pas ; le mot de passe devra être changé à la première connexion.
ADMIN_PSEUDO="admin.club"
ADMIN_PASSWORD="change-moi-tout-de-suite"

# Marque blanche (toutes optionnelles, lues au démarrage). Logos à déposer dans public/logo/.
APP_NAME="Race jeunes"
CLUB_NAME=""
CLUB_SHORT_NAME=""
BRAND_LOGO=""
BRAND_LOGO_LIGHT=""

# Données de démonstration (deux saisons, ~20 pseudos, matchs). Ne jamais activer en production réelle.
SEED_DEMO="false"

# "true" derrière un proxy HTTPS (cookie Secure). Mettre "false" pour un test local en HTTP.
COOKIE_SECURE="false"
