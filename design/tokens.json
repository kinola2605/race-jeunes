{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Design tokens — Race jeunes. Source unique pour le thème de l'application. Palette refaite le 2026-11-09 sur deux couleurs principales : bleu marine #1F2B42 et terre battue #BA6735 (visuel du club). Voir design/identite.md pour la provenance et les contrastes.",
  "color": {
    "brand": {
      "marine":      { "$type": "color", "$value": "#1F2B42", "$description": "Bleu marine — couleur principale n° 1, fond de l'application" },
      "marine-deep": { "$type": "color", "$value": "#161F31", "$description": "Bleu marine profond — zones en creux" },
      "clay-light":        { "$type": "color", "$value": "#EBB08C", "$description": "Terre battue claire — accent primaire, aplats de mise en avant (7,5:1 avec le bleu marine)" },
      "white-smoke":   { "$type": "color", "$value": "#F6F6F6", "$description": "Blanc cassé — titres et texte principal (variable CSS --white-smoke)" },
      "light-grey":    { "$type": "color", "$value": "#D6D6D6", "$description": "Gris clair — texte courant secondaire (variable CSS --light-grey)" },
      "grey":          { "$type": "color", "$value": "#A0A0A0", "$description": "Gris moyen (variable CSS --dark-grey)" },
      "dim-grey":      { "$type": "color", "$value": "#5E5E5E", "$description": "Gris foncé (variable CSS --dim-grey)" },
      "steel":         { "$type": "color", "$value": "#59667E", "$description": "Bleu acier (haut du dégradé marine). Décoratif uniquement" },
      "clay-bright":         { "$type": "color", "$value": "#E28C57", "$description": "Terre battue vive — perfs, action primaire, chiffres clés (5,48:1 sur bleu marine, 4,63:1 sur carte)" },
      "clay":    { "$type": "color", "$value": "#BA6735", "$description": "Terre battue — couleur principale n° 2 (#BA6735), filets et aplats décoratifs" },
      "violet":        { "$type": "color", "$value": "#4E39EA", "$description": "Bleu-violet — court dur dans les pictogrammes SVG du site. Interdit en texte sur fond sombre (2,19:1)" },
      "logo-ink":      { "$type": "color", "$value": "#172134", "$description": "Encre de la variante bleue du logo" },
      "white":         { "$type": "color", "$value": "#FFFFFF" }
    },
    "accessible": {
      "$description": "Variantes créées pour respecter WCAG AA là où la couleur de marque échoue.",
      "violet-on-dark":   { "$type": "color", "$value": "#9A9CF5", "$description": "Remplace violet en texte/icône sur bleu nuit (5,96:1)" },
      "coral-on-light":   { "$type": "color", "$value": "#9C4F22", "$description": "Terre battue foncée : remplace la terre battue en texte sur fond clair (5,91:1 sur blanc)" },
      "steel-on-dark":    { "$type": "color", "$value": "#8AA3BE", "$description": "Bordures de champs sur fond sombre (≥ 3:1)" },
      "steel-on-light":   { "$type": "color", "$value": "#5F7186", "$description": "Texte atténué et bordures de champs sur fond clair (5,01:1 sur blanc)" }
    }
  },
  "theme": {
    "dark": {
      "$description": "Thème par défaut : bleu marine + terre battue.",
      "bg":              { "$type": "color", "$value": "{color.brand.marine}" },
      "surface-sunken":  { "$type": "color", "$value": "{color.brand.marine-deep}", "$description": "Champs de saisie, zones en creux" },
      "surface-raised":  { "$type": "color", "$value": "#29374F", "$description": "Cartes (direction B), ligne survolée" },
      "text":            { "$type": "color", "$value": "{color.brand.white-smoke}" },
      "text-muted":      { "$type": "color", "$value": "{color.brand.light-grey}" },
      "text-subtle":     { "$type": "color", "$value": "#B4BCC6", "$description": "Métadonnées (≥ 4,5:1 sur toutes les surfaces sombres)" },
      "line":            { "$type": "color", "$value": "{color.brand.clay}", "$description": "Filet de grille 1 px terre battue (3,43:1, composant d'interface)" },
      "line-soft":       { "$type": "color", "$value": "#3B4A66", "$description": "Filet intérieur allégé (mobile, tableaux denses) — décoratif" },
      "field-border":    { "$type": "color", "$value": "{color.accessible.steel-on-dark}" },
      "accent":          { "$type": "color", "$value": "{color.brand.clay-light}", "$description": "Action primaire, onglet actif" },
      "on-accent":       { "$type": "color", "$value": "{color.brand.marine}" },
      "accent-2":        { "$type": "color", "$value": "{color.brand.clay-bright}", "$description": "Perfs, mise en avant" },
      "on-accent-2":     { "$type": "color", "$value": "{color.brand.marine}" },
      "accent-3":        { "$type": "color", "$value": "{color.accessible.violet-on-dark}", "$description": "Liens secondaires, séries de données" },
      "focus":           { "$type": "color", "$value": "#FFFFFF" },
      "success":         { "$type": "color", "$value": "#6FDC9C" },
      "error":           { "$type": "color", "$value": "#FF8A80" },
      "warning":         { "$type": "color", "$value": "#FFD166" },
      "info":            { "$type": "color", "$value": "#7CC4FF" }
    },
    "light": {
      "$description": "Thème clair optionnel (plein soleil), dérivé de la charte.",
      "bg":              { "$type": "color", "$value": "{color.brand.white-smoke}" },
      "surface-sunken":  { "$type": "color", "$value": "#FFFFFF" },
      "surface-raised":  { "$type": "color", "$value": "#FFFFFF" },
      "text":            { "$type": "color", "$value": "{color.brand.marine}" },
      "text-muted":      { "$type": "color", "$value": "#2E3B55" },
      "text-subtle":     { "$type": "color", "$value": "{color.accessible.steel-on-light}" },
      "line":            { "$type": "color", "$value": "{color.brand.marine}", "$description": "Filet de grille 1 px" },
      "line-soft":       { "$type": "color", "$value": "#C9D2DC", "$description": "Décoratif" },
      "field-border":    { "$type": "color", "$value": "{color.accessible.steel-on-light}" },
      "accent":          { "$type": "color", "$value": "{color.brand.marine}", "$description": "Action primaire : bleu marine plein, texte blanc" },
      "on-accent":       { "$type": "color", "$value": "#FFFFFF" },
      "accent-2":        { "$type": "color", "$value": "{color.accessible.coral-on-light}" },
      "on-accent-2":     { "$type": "color", "$value": "#FFFFFF" },
      "accent-3":        { "$type": "color", "$value": "{color.brand.violet}" },
      "highlight":       { "$type": "color", "$value": "{color.brand.clay-light}", "$description": "Aplat terre battue claire (bandeau, sélection) — toujours avec texte bleu marine et un indicateur non coloré" },
      "focus":           { "$type": "color", "$value": "{color.brand.violet}" },
      "success":         { "$type": "color", "$value": "#1E7B46" },
      "error":           { "$type": "color", "$value": "#B3261E" },
      "warning":         { "$type": "color", "$value": "#8A5A00" },
      "info":            { "$type": "color", "$value": "#1D5FA8" }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Poppins", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"], "$description": "Poppins (SIL OFL 1.1), auto-hébergée : design/assets/fonts" },
      "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Consolas", "monospace"], "$description": "Mots de passe temporaires, identifiants" }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "xs":      { "$type": "dimension", "$value": "12px", "$description": "Menus en capitales, étiquettes" },
      "sm":      { "$type": "dimension", "$value": "14px" },
      "base":    { "$type": "dimension", "$value": "16px", "$description": "Corps (le site utilise 14 px ; 16 px retenu pour la lecture en plein air)" },
      "lg":      { "$type": "dimension", "$value": "18px" },
      "xl":      { "$type": "dimension", "$value": "20px" },
      "2xl":     { "$type": "dimension", "$value": "24px", "$description": "H3 du site" },
      "3xl":     { "$type": "dimension", "$value": "32px", "$description": "H1 du site" },
      "display": { "$type": "dimension", "$value": "56px", "$description": "Chiffres clés (points, rang)" }
    },
    "lineHeight": {
      "tight":  { "$type": "number", "$value": 1.15 },
      "snug":   { "$type": "number", "$value": 1.35 },
      "normal": { "$type": "number", "$value": 1.55 }
    },
    "letterSpacing": {
      "caps": { "$type": "dimension", "$value": "0.08em", "$description": "Menus et étiquettes en capitales (site : 1 px à 12 px)" },
      "normal": { "$type": "dimension", "$value": "0" }
    }
  },
  "space": {
    "0":  { "$type": "dimension", "$value": "0" },
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "none":   { "$type": "dimension", "$value": "0" },
    "sm":     { "$type": "dimension", "$value": "8px" },
    "button": { "$type": "dimension", "$value": "15px", "$description": "Boutons du site (.button-inline-blue)" },
    "card":   { "$type": "dimension", "$value": "20px", "$description": "Photos du site (.padel-img1)" },
    "pill":   { "$type": "dimension", "$value": "999px" }
  },
  "border": {
    "hairline":  { "$type": "dimension", "$value": "1px", "$description": "Filets de grille" },
    "thick":     { "$type": "dimension", "$value": "2px", "$description": "Champ actif, filet d'accent" },
    "title-bar": { "$type": "dimension", "$value": "40px × 5px", "$description": "Trait sous les titres centrés (site : .div-block-42)" }
  },
  "shadow": {
    "none":  { "$type": "shadow", "$value": "none", "$description": "Rendu à plat, aucune ombre portée" },
    "focus": { "$type": "shadow", "$value": "0 0 0 2px {theme.*.bg}, 0 0 0 4px {theme.*.focus}", "$description": "Anneau de focus (seule « ombre » autorisée)" }
  },
  "size": {
    "touch-min":   { "$type": "dimension", "$value": "44px", "$description": "Cible tactile minimale (WCAG 2.5.5 visé)" },
    "touch-court": { "$type": "dimension", "$value": "52px", "$description": "Saisie de match en bord de court" },
    "content-max": { "$type": "dimension", "$value": "1200px" }
  },
  "breakpoint": {
    "mobile":  { "$type": "dimension", "$value": "390px", "$description": "Cible de conception" },
    "tablet":  { "$type": "dimension", "$value": "768px" },
    "desktop": { "$type": "dimension", "$value": "1024px" },
    "wide":    { "$type": "dimension", "$value": "1280px" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "base": { "$type": "duration", "$value": "200ms", "$description": "Désactivé si prefers-reduced-motion" }
  }
}
